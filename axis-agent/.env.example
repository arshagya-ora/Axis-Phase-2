# Development only. Never commit real values.
AXIS_ENVIRONMENT=development
AXIS_MODEL_MODE=mock
AXIS_DATABASE_PATH=.axis-data/axis.db
AXIS_FIREWALL_POLICY_PATH=config/firewall.example.json
AXIS_LOG_LEVEL=INFO

# Live mode. Never commit a real API key or project OCID.
AXIS_OCI_BASE_URL=https://inference.generativeai.us-ashburn-1.oci.oraclecloud.com/openai/v1
AXIS_OCI_PROJECT_OCID=
AXIS_OCI_AUTH_MODE=api_key
AXIS_OCI_GENAI_API_KEY=
AXIS_OCI_CONFIG_FILE=~/.oci/config
AXIS_OCI_PROFILE=DEFAULT
AXIS_PLANNER_MODEL=xai.grok-4.3
AXIS_NAVIGATOR_MODEL=xai.grok-4.20-0309-non-reasoning
